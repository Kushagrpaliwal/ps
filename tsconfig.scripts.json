{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist-scripts",
    "rootDir": "./scripts",
    "declaration": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
